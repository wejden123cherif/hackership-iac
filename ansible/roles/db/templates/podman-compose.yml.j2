version: "3.8"

# Mirrors the db/redis services from the project's docker-compose.yml
# exactly (same images, same redis flags) — only real credentials and
# the persistent-volume bind mount differ from the local dev version.

services:
  postgres:
    image: docker.io/library/postgres:16-alpine
    container_name: hackership-postgres
    environment:
      POSTGRES_USER: "{{ postgres_user }}"
      POSTGRES_PASSWORD: "{{ postgres_password }}"
      POSTGRES_DB: "{{ postgres_db }}"
    volumes:
      - "{{ db_data_mount }}/postgres:/var/lib/postgresql/data"
    ports:
      - "{{ postgres_port }}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }}"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  redis:
    image: docker.io/library/redis:7-alpine
    container_name: hackership-redis
    command: redis-server --save 60 1 --loglevel warning
    volumes:
      - "{{ db_data_mount }}/redis:/data"
    ports:
      - "{{ redis_port }}:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped
