[Unit]
Description=Hackership - nginx + web (Podman Compose)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{ hackership_deploy_dir }}
User={{ ansible_user }}
ExecStartPre=-/usr/bin/podman-compose -f {{ hackership_deploy_dir }}/podman-compose.yml down
ExecStart=/usr/bin/podman-compose -f {{ hackership_deploy_dir }}/podman-compose.yml up
ExecStop=/usr/bin/podman-compose -f {{ hackership_deploy_dir }}/podman-compose.yml down
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
